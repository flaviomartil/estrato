{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture documentation project",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "snapshot": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "theme": {
          "enum": [
            "paper",
            "limestone",
            "graphite"
          ]
        },
        "language": {
          "const": "pt-BR"
        }
      },
      "required": [
        "name"
      ]
    },
    "maps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/map"
      },
      "minItems": 1,
      "maxItems": 80
    },
    "guide": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guide"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "maps"
  ],
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "technology": {
          "type": "string"
        },
        "status": {
          "enum": [
            "observed",
            "inferred",
            "proposed"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 20000
          },
          "minItems": 2,
          "maxItems": 2
        },
        "size": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 200,
              "maximum": 20000
            },
            {
              "type": "number",
              "minimum": 126,
              "maximum": 20000
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": false
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "variant": {
          "enum": [
            "default",
            "emphasis",
            "conditional"
          ]
        },
        "status": {
          "enum": [
            "observed",
            "inferred",
            "proposed"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        },
        "via": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": -30000,
              "maximum": 30000
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "labelAt": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -30000,
            "maximum": 30000
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "id",
        "from",
        "to"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        }
      },
      "required": [
        "title"
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "label": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "label",
        "nodes"
      ]
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "text"
      ]
    },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "type": {
          "enum": [
            "architecture",
            "workflow",
            "sequence",
            "dataflow",
            "lifecycle"
          ]
        },
        "direction": {
          "enum": [
            "LR",
            "TB"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 1,
          "maxItems": 160
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          },
          "maxItems": 500
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "nodes",
        "edges"
      ]
    },
    "guide": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "body"
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "integer",
          "minimum": 1
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "excerpt": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "start",
        "end"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "title": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "title",
        "references"
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "status": {
          "enum": [
            "observed",
            "inferred",
            "proposed"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
          }
        }
      },
      "required": [
        "id",
        "title",
        "description"
      ]
    }
  }
}
